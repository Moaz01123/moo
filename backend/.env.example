# --- Database ---
# Default is local SQLite. For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/kavo
DATABASE_URL=sqlite:///./kavo.db

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kavo-admin-2026

# --- CORS (comma separated, or * for all) ---
CORS_ORIGINS=*

# --- Optional: OpenAI for the support assistant (falls back to rule-based) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional: Stripe (structure is ready) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
